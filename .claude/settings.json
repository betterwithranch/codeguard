{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv sync --quiet --frozen --project \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEGUARD=\"$CLAUDE_PROJECT_DIR/.venv/bin/codeguard\" uv run --quiet --script \"$CLAUDE_PROJECT_DIR/hooks/stop.py\" claude-code"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CODEGUARD=\"$CLAUDE_PROJECT_DIR/.venv/bin/codeguard\" uv run --quiet --script \"$CLAUDE_PROJECT_DIR/hooks/stop.py\" claude-code"
          }
        ]
      }
    ]
  }
}
