{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/hooks/rule_files.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\" claude-code"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.py\" claude-code"
          }
        ]
      }
    ]
  }
}
